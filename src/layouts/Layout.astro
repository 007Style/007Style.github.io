---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Daneyand "DJ" Singley — Engineer · Creator · IBM',
  description = 'IBM Field CTO · Legendary Engineer · Open-source builder · DJ · Ski fanatic. Based in Columbus, OH.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/headshot.png" />
    <link rel="icon" type="image/png" href="/headshot.png" />
    <title>{title}</title>
  </head>
  <body class="circuit-bg">
    <!-- ── Fixed Nav ── -->
    <nav class="fixed top-0 left-0 right-0 z-50 flex items-center justify-between px-6 py-4"
         style="background: rgba(9,9,11,0.85); backdrop-filter: blur(12px); border-bottom: 1px solid rgba(39,39,42,0.5);">
      <a href="/" class="font-mono text-xs tracking-widest text-cyan-400 hover:text-cyan-300 transition-colors">
        &gt; daneyand<span class="text-amber-400">_</span>
      </a>
      <div class="hidden md:flex gap-6">
        <a href="#about">about</a>
        <a href="#experience">exp</a>
        <a href="#career">career</a>
        <a href="#skills">skills</a>
        <a href="#projects">projects</a>
        <a href="#videos">videos</a>
        <a href="#music">music</a>
        <a href="#contact">contact</a>
      </div>
      <a href="https://github.com/007Style" target="_blank" rel="noopener"
         class="font-mono text-xs text-zinc-500 hover:text-cyan-400 transition-colors hidden md:block">
        github.com/007Style →
      </a>
    </nav>

    <slot />

    <!-- ── Footer ── -->
    <footer class="text-center py-10 px-4 border-t border-zinc-800 mt-20">
      <p class="font-mono text-xs text-zinc-600">
        &copy; {new Date().getFullYear()} Daneyand "DJ" Singley ·
        <span class="text-cyan-500">Columbus, OH</span> ·
        Built with Astro + IBM Bob
      </p>
    </footer>

    <!-- ── Scroll reveal ── -->
    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              observer.unobserve(e.target);
            }
          });
        },
        { threshold: 0.1 }
      );
      document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
    </script>
  </body>
</html>

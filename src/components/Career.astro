---

<section id="career" class="py-28 px-6 max-w-6xl mx-auto">
  <div class="section-label mb-4 reveal">// career.fullHistory()</div>
  <h2 class="text-3xl md:text-5xl font-black mb-6 reveal">
    Three Decades of<br/>
    <span class="text-cyan-400">Building Things</span>
  </h2>
  <p class="text-zinc-500 max-w-2xl mb-20 reveal text-sm leading-relaxed">
    From wireless simulation research at Rutgers in 1998, through IBM Research hardware engineering and processor patents,
    to Field CTO leadership at IBM scale — a career defined by genuine depth across silicon, software, AI, and people.
  </p>

  <!-- ── Roles ── -->
  <div class="space-y-6 mb-24">
    {roles.map((r, i) => {
      const isCyan = r.accent === 'cyan';
      return (
        <div class={`reveal`} style={`transition-delay:${i*80}ms`}>
          <div class={`p-6 rounded-xl bg-zinc-900/60 glow-card border-l-2 ${isCyan ? 'border-l-cyan-400' : 'border-l-amber-400'}`}>
            <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
              <div>
                <h3 class="text-lg font-bold text-zinc-100">{r.title}</h3>
                <a href={r.companyUrl} target="_blank" rel="noopener"
                   class={`font-mono text-sm hover:underline ${isCyan ? 'text-cyan-400' : 'text-amber-400'}`}>
                  {r.company} ↗
                </a>
              </div>
              <div class="text-right">
                <div class="font-mono text-xs text-zinc-500">{r.period}</div>
                <div class="text-xs text-zinc-600 mt-0.5">{r.location}</div>
              </div>
            </div>
            <ul class="space-y-2">
              {r.highlights.map(h => (
                <li class="flex gap-3 text-sm text-zinc-400 leading-relaxed">
                  <span class={`mt-1.5 flex-shrink-0 w-1.5 h-1.5 rounded-full ${isCyan ? 'bg-cyan-400' : 'bg-amber-400'}`}></span>
                  {h}
                </li>
              ))}
            </ul>
          </div>
        </div>
      );
    })}
  </div>

  <!-- ── Milestone timeline ── -->
  <div class="mb-24 reveal">
    <div class="section-label mb-8">// milestones.render()</div>
    <div class="relative">
      <div class="absolute top-4 left-0 right-0 h-px bg-gradient-to-r from-cyan-400/40 via-amber-400/20 to-transparent hidden md:block"></div>
      <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
        {milestones.map((m, i) => (
          <div class="relative reveal" style={`transition-delay:${i*50}ms`}>
            <div class={`w-2.5 h-2.5 rounded-full mb-3 hidden md:block ${m.accent === 'cyan' ? 'bg-cyan-400' : 'bg-amber-400'}`}></div>
            <div class={`font-mono text-xs font-bold mb-1 ${m.accent === 'cyan' ? 'text-cyan-400' : 'text-amber-400'}`}>{m.year}</div>
            <div class="text-xs text-zinc-500 leading-snug">{m.label}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ── Patents ── -->
  <div id="patents" class="mb-20 reveal">
    <div class="section-label mb-6">// patents.load()</div>
    <h3 class="text-2xl md:text-3xl font-black mb-3">
      IBM <span class="text-amber-400">Patents</span>
    </h3>
    <p class="text-zinc-500 text-sm mb-8 max-w-xl">
      Two United States patents assigned to IBM Corporation — both in hardware engineering.
    </p>
    <div class="space-y-4">
      {patents.map((p, i) => (
        <a href={p.url} target="_blank" rel="noopener"
           class="group block p-6 rounded-xl bg-zinc-900/60 glow-card reveal"
           style={`transition-delay:${i*80}ms`}>
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <span class="font-mono text-xs text-amber-400 border border-amber-400/30 px-2 py-0.5 rounded">
                  {p.number}
                </span>
                <span class="font-mono text-xs text-zinc-600">{p.type}</span>
                <span class="font-mono text-xs text-zinc-700">Filed {p.filed} · Granted {p.year}</span>
              </div>
              <h4 class="text-base font-bold text-zinc-100 group-hover:text-cyan-400 transition-colors mb-2">{p.title}</h4>
              <p class="text-sm text-zinc-500 leading-relaxed mb-3">{p.description}</p>
              {p.award && (
                <div class="flex items-center gap-2">
                  <span class="text-amber-400 text-xs">🏆</span>
                  <span class="font-mono text-xs text-amber-500">{p.award}</span>
                </div>
              )}
            </div>
            <span class="font-mono text-xs text-cyan-400 border border-cyan-400/30 px-3 py-1.5 rounded group-hover:bg-cyan-400/10 transition-colors flex-shrink-0">
              search USPTO →
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- ── Awards ── -->
  <div class="mb-20 reveal">
    <div class="section-label mb-6">// awards.enumerate()</div>
    <h3 class="text-2xl md:text-3xl font-black mb-8">
      <span class="text-cyan-400">Recognition</span>
    </h3>
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
      {awards.map((a, i) => {
        const isCyan = a.accent === 'cyan';
        return (
          <div class={`p-5 rounded-xl bg-zinc-900/60 glow-card reveal`} style={`transition-delay:${i*70}ms`}>
            <div class="flex items-start gap-3 mb-3">
              <span class="text-xl flex-shrink-0">{isCyan ? '🔵' : '🏆'}</span>
              <h4 class={`font-semibold text-sm text-zinc-100 leading-snug`}>{a.title}</h4>
            </div>
            <p class="text-xs text-zinc-500 leading-relaxed">{a.detail}</p>
          </div>
        );
      })}
    </div>
  </div>

  <!-- ── Publications ── -->
  <div class="reveal">
    <div class="section-label mb-6">// publications.list()</div>
    <h3 class="text-2xl md:text-3xl font-black mb-8">
      <span class="text-amber-400">Publications</span>
    </h3>
    <div class="space-y-3">
      {publications.map((pub, i) => (
        <a href={pub.url} target="_blank" rel="noopener"
           class="group flex items-center gap-4 p-5 rounded-xl bg-zinc-900/60 glow-card reveal"
           style={`transition-delay:${i*60}ms`}>
          <div class="w-8 h-8 flex-shrink-0 rounded-lg bg-amber-400/10 flex items-center justify-center text-amber-400 font-mono text-xs font-bold">
            {String(i+1).padStart(2,'0')}
          </div>
          <div class="flex-1 min-w-0">
            <p class="text-sm font-medium text-zinc-200 group-hover:text-cyan-400 transition-colors leading-snug">{pub.title}</p>
            <p class="font-mono text-xs text-zinc-600 mt-1">{pub.type}</p>
          </div>
          <svg class="w-3.5 h-3.5 text-zinc-700 group-hover:text-zinc-400 transition-colors flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      ))}
    </div>
  </div>
</section>

---

<section id="contact" class="py-28 px-6 max-w-5xl mx-auto">
  <div class="section-label mb-4 reveal">// contact.open()</div>
  <h2 class="text-3xl md:text-4xl font-black mb-4 reveal">
    Find <span class="text-cyan-400">Me</span>
  </h2>
  <p class="text-zinc-500 mb-16 reveal max-w-xl">
    Whether it's about engineering, collaboration, music, film, or just a great run down the mountain — say hi.
  </p>

  <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
    {links.map((link, i) => {
      const isCyan = link.accent === 'cyan';
      return (
        <a href={link.url} target="_blank" rel="noopener"
           class={`group flex items-center gap-4 p-5 rounded-xl bg-zinc-900/60 glow-card ${!isCyan ? 'glow-amber' : ''} reveal`}
           style={`transition-delay: ${i * 60}ms`}>
          <div class={`w-10 h-10 flex-shrink-0 rounded-lg flex items-center justify-center ${isCyan ? 'text-cyan-400 bg-cyan-400/10' : 'text-amber-400 bg-amber-400/10'} group-hover:scale-110 transition-transform`}
               set:html={link.icon}>
          </div>
          <div class="min-w-0">
            <div class="text-sm font-semibold text-zinc-100 truncate">{link.label}</div>
            <div class={`font-mono text-xs mt-0.5 ${isCyan ? 'text-cyan-500' : 'text-amber-500'} truncate`}>{link.sublabel}</div>
          </div>
          <svg class="w-3.5 h-3.5 text-zinc-700 group-hover:text-zinc-400 transition-colors ml-auto flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
          </svg>
        </a>
      );
    })}
  </div>

  <!-- tagline -->
  <div class="mt-24 text-center reveal">
    <p class="font-mono text-xs text-zinc-700 italic">
      From the minds of IBM Bob &amp; Daneyand
    </p>
  </div>
</section>

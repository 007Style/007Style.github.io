---
// Videos — personal YouTube + IBM YouTube
---

<section id="videos" class="py-28 px-6 max-w-6xl mx-auto">
  <div class="section-label mb-4 reveal">// videos.stream()</div>
  <h2 class="text-3xl md:text-4xl font-black mb-4 reveal">
    On <span class="text-cyan-400">Camera</span>
  </h2>
  <p class="text-zinc-500 mb-16 reveal">Ski runs, creative adventures, IBM tech talks, and more.</p>

  <div class="grid md:grid-cols-2 gap-8">
    <!-- Personal channel -->
    <div class="reveal">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-2 h-2 rounded-full bg-amber-400"></div>
        <span class="font-mono text-xs text-amber-400 uppercase tracking-widest">personal channel</span>
      </div>
      <a href="https://www.youtube.com/@daneyand" target="_blank" rel="noopener"
         class="group block rounded-xl overflow-hidden glow-card glow-amber bg-zinc-900/60">
        <!-- YouTube channel thumbnail via nocookie embed -->
        <div class="relative aspect-video bg-zinc-800 flex items-center justify-center overflow-hidden">
          <img
            src="https://img.youtube.com/vi/dQw4w9WgXcQ/maxresdefault.jpg"
            alt="YouTube channel"
            class="absolute inset-0 w-full h-full object-cover opacity-0"
          />
          <!-- custom placeholder -->
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 text-center"
               style="background: linear-gradient(135deg, rgba(251,191,36,0.08) 0%, rgba(9,9,11,0.9) 100%);">
            <svg class="w-16 h-16 text-amber-400 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
            </svg>
            <div>
              <div class="text-lg font-bold text-zinc-100">@daneyand</div>
              <div class="text-sm text-zinc-500 mt-1">Skiing · Adventures · Creative Projects</div>
            </div>
          </div>
        </div>
        <div class="p-4 flex items-center justify-between">
          <div>
            <div class="font-semibold text-zinc-100">Daneyand</div>
            <div class="font-mono text-xs text-zinc-600 mt-0.5">youtube.com/@daneyand</div>
          </div>
          <span class="font-mono text-xs text-amber-400 border border-amber-400/30 px-3 py-1 rounded">
            watch →
          </span>
        </div>
      </a>
    </div>

    <!-- IBM channel -->
    <div class="reveal" style="transition-delay: 100ms">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
        <span class="font-mono text-xs text-cyan-400 uppercase tracking-widest">IBM channel</span>
      </div>
      <a href="https://www.youtube.com/@DaneyandIBM" target="_blank" rel="noopener"
         class="group block rounded-xl overflow-hidden glow-card bg-zinc-900/60">
        <div class="relative aspect-video bg-zinc-800 flex items-center justify-center overflow-hidden">
          <div class="absolute inset-0 flex flex-col items-center justify-center gap-4 p-8 text-center"
               style="background: linear-gradient(135deg, rgba(34,211,238,0.08) 0%, rgba(9,9,11,0.9) 100%);">
            <svg class="w-16 h-16 text-cyan-400 group-hover:scale-110 transition-transform" viewBox="0 0 24 24" fill="currentColor">
              <path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/>
            </svg>
            <div>
              <div class="text-lg font-bold text-zinc-100">@DaneyandIBM</div>
              <div class="text-sm text-zinc-500 mt-1">Tech Talks · IBM · Engineering</div>
            </div>
          </div>
        </div>
        <div class="p-4 flex items-center justify-between">
          <div>
            <div class="font-semibold text-zinc-100">Daneyand IBM</div>
            <div class="font-mono text-xs text-zinc-600 mt-0.5">youtube.com/@DaneyandIBM</div>
          </div>
          <span class="font-mono text-xs text-cyan-400 border border-cyan-400/30 px-3 py-1 rounded">
            watch →
          </span>
        </div>
      </a>
    </div>
  </div>
</section>

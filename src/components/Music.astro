---

<section id="music" class="py-28 px-6 max-w-5xl mx-auto">
  <div class="section-label mb-4 reveal">// music.play()</div>
  <h2 class="text-3xl md:text-4xl font-black mb-4 reveal">
    DJ <span class="text-amber-400">DaneyandO</span>
  </h2>
  <p class="text-zinc-500 mb-16 reveal max-w-xl">
    When the compiler compiles and the tests pass — the decks come out.
    Electronic, house, and everything in between. Find the music everywhere you stream.
  </p>

  <div class="grid md:grid-cols-2 gap-8 items-start">
    <!-- Apple Music embed (primary) -->
    <div class="reveal">
      <div class="flex items-center gap-3 mb-5">
        <div class="w-2 h-2 rounded-full bg-cyan-400"></div>
        <span class="font-mono text-xs text-cyan-400 uppercase tracking-widest">apple music</span>
      </div>
      <div class="rounded-xl overflow-hidden glow-card" style="height: 450px;">
        <iframe
          allow="autoplay *; encrypted-media *; fullscreen *; clipboard-write"
          frameborder="0"
          height="450"
          style="width:100%;overflow:hidden;border-radius:0.75rem;background:transparent;"
          sandbox="allow-forms allow-popups allow-same-origin allow-scripts allow-storage-access-by-user-activation allow-top-navigation-by-user-activation"
          src="https://embed.music.apple.com/us/artist/dj-daneyando/6812402003"
        ></iframe>
      </div>
    </div>

    <!-- Right column: all platforms + EQ -->
    <div class="space-y-4 reveal" style="transition-delay: 100ms">
      <div class="font-mono text-xs text-zinc-500 uppercase tracking-widest mb-2">stream everywhere</div>

      {platforms.map(p => {
        const isCyan = p.accent === 'cyan';
        return (
          <a href={p.url} target="_blank" rel="noopener"
             class={`group flex items-center gap-4 p-4 rounded-xl bg-zinc-900/60 glow-card ${!isCyan ? 'glow-amber' : ''} transition-all`}>
            <div class={`w-10 h-10 flex-shrink-0 rounded-lg flex items-center justify-center ${isCyan ? 'text-cyan-400 bg-cyan-400/10' : 'text-amber-400 bg-amber-400/10'} group-hover:scale-110 transition-transform`}
                 set:html={p.icon}>
            </div>
            <div class="min-w-0">
              <div class="text-sm font-semibold text-zinc-100">{p.label}</div>
              <div class={`font-mono text-xs mt-0.5 ${isCyan ? 'text-cyan-500' : 'text-amber-500'}`}>{p.handle}</div>
            </div>
            <svg class="w-3.5 h-3.5 text-zinc-700 group-hover:text-zinc-400 transition-colors ml-auto flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </a>
        );
      })}

      <!-- animated EQ bars -->
      <div class="p-5 rounded-xl bg-zinc-900/60 glow-card flex items-end justify-center gap-1 mt-2" style="height: 80px;">
        {Array.from({ length: 28 }, (_, i) => (
          <div class="eq-bar w-1.5 rounded-t"
               style={`background: ${i % 3 === 0 ? '#fbbf24' : '#22d3ee'}; height: ${Math.random() * 50 + 8}px; animation: eq ${(0.3 + Math.random() * 0.7).toFixed(2)}s ease-in-out infinite alternate; animation-delay: ${(Math.random() * 0.6).toFixed(2)}s`}>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
@keyframes eq {
  from { transform: scaleY(0.15); }
  to   { transform: scaleY(1); }
}
.eq-bar { transform-origin: bottom; }
</style>

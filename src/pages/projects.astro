  { name: 'WingmanAI', desc: '🪿 Ambient macOS AI wingman — IBM Granite + LLaVA via Ollama. Watches your screen, understands what you\'re doing, helps without being asked. 100% local.', lang: 'Dart', url: 'https://github.com/007Style/WingmanAI', topics: ['ai','ambient-ai','dart','flutter','ibm-granite','llava','local-llm','macos','ollama','screen-awareness'] },
  { name: 'beeMon', desc: '🐝 Beautiful native macOS system monitor — CPU per-core, memory & network with menu-bar sparkline.', lang: 'Swift', url: 'https://github.com/007Style/beeMon', topics: [] },

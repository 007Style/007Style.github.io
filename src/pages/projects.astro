  { name: 'rSMT', desc: 'Reverse SMT processor simulator — IBM Patent US8595468.', lang: 'Java', url: 'https://github.com/007Style/rSMT', topics: [] },
  { name: 'MaRTIni-v2', desc: 'MaRTIni v2 — Modernized Java 22 wireless simulation GUI. Evolution of the 1998-1999 WINLab Rutgers prototype.', lang: 'Java', url: 'https://github.com/007Style/MaRTIni-v2', topics: [] },
  { name: 'MaRTIni-v1', desc: 'Mobile and Radio Technology Interface — Java AWT wireless simulation prototype, WINLab Rutgers University, 1998-1999.', lang: 'Java', url: 'https://github.com/007Style/MaRTIni-v1', topics: [] },
  { name: 'traceAnalyzer', desc: 'IBM PowerPC processor trace file analyzer — converts .TRACER simulator output to color-coded HTML pipeline visualization (Java, 2002).', lang: 'Scilab', url: 'https://github.com/007Style/traceAnalyzer', topics: [] },
  { name: 'ipKangaroo', desc: 'ipKangaroo — personalized web portal with buddy list, VoIP, news/sports/weather.', lang: 'Java', url: 'https://github.com/007Style/ipKangaroo', topics: [] },
  { name: 'ipKweb2.0', desc: 'ipKangaroo 2.0 — personalized web portal with buddy list, VoIP, news/sports/weather/TV widgets. Rutgers University Senior Project, 2001.', lang: 'Classic ASP', url: 'https://github.com/007Style/ipKweb2.0', topics: [] },
  { name: 'acornEncrypt', desc: 'Java symmetric encryption sandbox — DES, Blowfish, and Chilkat library demos.', lang: 'Java', url: 'https://github.com/007Style/acornEncrypt', topics: [] },
  { name: 'echoAppSSL', desc: 'Java SSL/TLS echo client-server demo using javax.net.ssl with object serialisation.', lang: 'Java', url: 'https://github.com/007Style/echoAppSSL', topics: [] },
  { name: 'socks', desc: 'TCP/IP socket programming learning projects circa 2000 — C (POSIX sockets) and Java demos.', lang: 'Java', url: 'https://github.com/007Style/socks', topics: [] },
  { name: 'threads', desc: 'Self-calibrating Java thread benchmark — finds optimal thread count for your CPU.', lang: 'Java', url: 'https://github.com/007Style/threads', topics: [] },
  { name: 'java_webThreads', desc: 'Two Java utilities: a self-calibrating JVM thread-count optimizer and a bulk web keyword profiler.', lang: 'Java', url: 'https://github.com/007Style/java_webThreads', topics: [] },
  { name: 'randomCode', desc: 'Random pieces of code used in various projects.', lang: 'Java', url: 'https://github.com/007Style/randomCode', topics: [] },
  { name: 'JORT', desc: 'Raspberry Pi environmental sensor — AM2320 I2C + Soracom LTE + Firebase Firestore.', lang: 'JavaScript', url: 'https://github.com/007Style/JORT', topics: [] },
  { name: 'lsdup', desc: '🔍 Fast, zero-dependency POSIX shell duplicate file finder. From the minds of IBM Bob & Daneyand.', lang: 'Shell', url: 'https://github.com/007Style/lsdup', topics: [] },
  { name: 'lsme', desc: 'List files owned by the current user. Fast, POSIX, no bloat.', lang: 'Shell', url: 'https://github.com/007Style/lsme', topics: [] },
  { name: 'lsnotme', desc: 'List files NOT owned by the current user. The companion to lsme. Fast, POSIX, no bloat.', lang: 'Shell', url: 'https://github.com/007Style/lsnotme', topics: [] },
  { name: 'lsnew', desc: 'List files new or modified since the last run.', lang: 'Shell', url: 'https://github.com/007Style/lsnew', topics: [] },
  { name: 'lsports', desc: 'List all open TCP and UDP ports with owning process — POSIX sh, zero dependencies.', lang: 'Shell', url: 'https://github.com/007Style/lsports', topics: [] },
  { name: 'lstcp', desc: 'List all open TCP ports with owning process — POSIX sh, zero dependencies.', lang: 'Shell', url: 'https://github.com/007Style/lstcp', topics: [] },
  { name: 'lsudp', desc: 'List all open UDP ports with owning process — POSIX sh, zero dependencies.', lang: 'Shell', url: 'https://github.com/007Style/lsudp', topics: [] },
  { name: 'lswho', desc: 'List who is on the system — POSIX shell.', lang: 'Shell', url: 'https://github.com/007Style/lswho', topics: [] },
  { name: 'lsyou', desc: 'List files belonging to you — POSIX shell.', lang: 'Shell', url: 'https://github.com/007Style/lsyou', topics: [] },

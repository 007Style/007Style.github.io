  { name: 'solarView', desc: '☀️ Real-time SolarEdge inverter & battery monitoring — Modbus TCP, live charts, no cloud required. Beerware license.', lang: 'Python', url: 'https://github.com/007Style/solarView', topics: [] },
  { name: 'procThumper', desc: '🔥 Cross-platform CPU · GPU · AI stress-test tool with a live dark-themed Qt UI.', lang: 'Python', url: 'https://github.com/007Style/procThumper', topics: [] },
  { name: 'solveDaCube', desc: 'Interactive ASCII terminal Rubik\'s Cube solver powered by Kociemba\'s two-phase algorithm. From the minds of IBM Bob & Daneyand.', lang: 'Python', url: 'https://github.com/007Style/solveDaCube', topics: [] },
  { name: 'PPC2ARM', desc: 'PowerPC ↔ ARM/AArch64 Instruction Picker — Retro ISA Museum Edition.', lang: 'Python', url: 'https://github.com/007Style/PPC2ARM', topics: [] },
  { name: 'PPC2x86', desc: 'PowerPC ↔ x86/x64 ISA Translation Station — lookup PPC and x86 instruction analogues with a retro ISA Museum GUI.', lang: 'Python', url: 'https://github.com/007Style/PPC2x86', topics: [] },

  { name: 'honeydue-cal-sync', desc: 'macOS menu bar app that syncs sanitised work calendar blocks to a personal/family calendar — no meeting details leak through.', lang: 'Swift', url: 'https://github.com/007Style/honeydue-cal-sync', topics: [] },
  { name: 'beeKey', desc: 'Native macOS mechanical keyboard audio synthesizer & live WPM tray tracker (Swift/SwiftUI).', lang: 'Swift', url: 'https://github.com/007Style/beeKey', topics: [] },

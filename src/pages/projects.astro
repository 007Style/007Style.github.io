  { name: 'EBDIC', desc: 'Small Java utility for comparing string representations in ASCII vs EBCDIC (CP500).', lang: 'Java', url: 'https://github.com/007Style/EBDIC', topics: [] },
  { name: 'procKiller', desc: 'Process killer utility — Java.', lang: 'Java', url: 'https://github.com/007Style/procKiller', topics: [] },
  { name: 'stockHound', desc: 'Stock hound — Java.', lang: 'Java', url: 'https://github.com/007Style/stockHound', topics: [] },
  { name: 'mailTester', desc: 'Mail tester utility — Java.', lang: 'Java', url: 'https://github.com/007Style/mailTester', topics: [] },
  { name: 'randNum', desc: 'Random number utility — Java.', lang: 'Java', url: 'https://github.com/007Style/randNum', topics: [] },
  { name: 'MiniTemplator_java', desc: 'MiniTemplator — Java.', lang: 'Java', url: 'https://github.com/007Style/MiniTemplator_java', topics: [] },
  { name: 'PLAY', desc: 'PLAY — Java.', lang: 'Java', url: 'https://github.com/007Style/PLAY', topics: [] },
  { name: 'UTF8', desc: 'UTF-8 utility — Java.', lang: 'Java', url: 'https://github.com/007Style/UTF8', topics: [] },
  { name: 'threadSaver', desc: 'Thread saver — Java.', lang: 'Java', url: 'https://github.com/007Style/threadSaver', topics: [] },
];

const langColor: Record<string, string> = {
  Dart: '#54C5F8', Swift: '#F05138', Rust: '#CE422B', JavaScript: '#F7DF1E',
  Python: '#3776AB', C: '#A8B9CC', GDScript: '#478CBF', Java: '#ED8B00',
  Go: '#00ACD7', Shell: '#4EAA25', 'C++': '#F34B7D', TypeScript: '#3178C6',
  HTML: '#E34C26', Scilab: '#9B59B6', 'Classic ASP': '#71717a',
};

// Group by language
const groups: Record<string, typeof repos> = {};
repos.forEach(r => {
  if (!groups[r.lang]) groups[r.lang] = [];
  groups[r.lang].push(r);
});
const langOrder = ['Swift', 'Rust', 'Dart', 'Go', 'Python', 'JavaScript', 'C', 'C++', 'Java', 'Shell', 'GDScript', 'HTML', 'Scilab', 'Classic ASP'];
const sorted = langOrder.filter(l => groups[l]).map(l => ({ lang: l, repos: groups[l] }));
---

<Layout title="Projects — Daneyand 007Style" description="All 69 open-source repositories by Daneyand DJ Singley on GitHub.">
  <div class="pt-28 pb-20 px-6 max-w-7xl mx-auto">
    <a href="/" class="font-mono text-xs text-zinc-600 hover:text-cyan-400 transition-colors mb-8 inline-block">← back</a>
    <div class="section-label mb-4">// repos.loadAll()</div>
    <h1 class="text-4xl md:text-6xl font-black mb-4">
      All <span class="text-cyan-400">Projects</span>
    </h1>
    <p class="text-zinc-500 mb-16 max-w-xl font-mono text-sm">
      {repos.length} repositories spanning Swift, Rust, Go, Java, Python, C, Dart, Shell, and more.
      Grouped by language.
    </p>

    <!-- Language filter buttons -->
    <div class="flex flex-wrap gap-2 mb-12" id="lang-filters">
      <button class="lang-btn active font-mono text-xs px-4 py-2 rounded border border-cyan-400 text-cyan-400" data-lang="all">
        all ({repos.length})
      </button>
      {sorted.map(g => (
        <button class="lang-btn font-mono text-xs px-4 py-2 rounded border border-zinc-700 text-zinc-500 hover:border-zinc-500 hover:text-zinc-300 transition-colors" data-lang={g.lang}>
          {g.lang} ({g.repos.length})
        </button>
      ))}
    </div>

    <!-- All cards -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="repo-grid">
      {repos.map((repo) => (
        <a href={repo.url} target="_blank" rel="noopener"
           class="repo-card group flex flex-col p-5 rounded-xl bg-zinc-900/60 glow-card reveal"
           data-lang={repo.lang}>
          <div class="flex items-start justify-between mb-3">
            <h3 class="font-mono text-sm font-semibold text-zinc-100 group-hover:text-cyan-400 transition-colors leading-tight">
              {repo.name}
            </h3>
            <svg class="w-3.5 h-3.5 text-zinc-600 group-hover:text-cyan-400 transition-colors flex-shrink-0 mt-0.5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
            </svg>
          </div>
          <p class="text-xs text-zinc-500 leading-relaxed flex-1 mb-4">{repo.desc}</p>
          <div class="flex items-center gap-2 mt-auto">
            <span class="w-2.5 h-2.5 rounded-full flex-shrink-0"
                  style={`background: ${langColor[repo.lang] ?? '#71717a'}`}></span>
            <span class="font-mono text-xs text-zinc-600">{repo.lang}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>

<script>
// Language filter
const btns = document.querySelectorAll<HTMLButtonElement>('.lang-btn');
const cards = document.querySelectorAll<HTMLElement>('.repo-card');

btns.forEach(btn => {
  btn.addEventListener('click', () => {
    const lang = btn.dataset.lang!;
    btns.forEach(b => {
      b.classList.remove('active', 'border-cyan-400', 'text-cyan-400');
      b.classList.add('border-zinc-700', 'text-zinc-500');
    });
    btn.classList.add('active', 'border-cyan-400', 'text-cyan-400');
    btn.classList.remove('border-zinc-700', 'text-zinc-500');

    cards.forEach(card => {
      if (lang === 'all' || card.dataset.lang === lang) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });
  });
});
</script>
